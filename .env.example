# 이 파일을 .env.local 로 복사해서 값을 채우세요. .env.local 은 저장소에 안 올라갑니다.

# ── 데이터베이스 ────────────────────────────────────
# Neon 에서 만든 연결 문자열. 내 컴퓨터의 postgres 주소를 넣어도 됩니다.
DATABASE_URL=

# ── 카카오 로그인 ───────────────────────────────────
# 카카오 개발자 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=
# 카카오 로그인 > 보안 > Client Secret
KAKAO_CLIENT_SECRET=

# ── 우리 쪽 ─────────────────────────────────────────
# 로그인 쪽지에 도장을 찍는 데 씁니다. 32자 이상 아무 무작위 문자열.
#   만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 이 앱이 올라가 있는 주소. 카카오에 등록한 Redirect URI 와 앞부분이 같아야 합니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 카카오 키 없이 나머지를 시험할 때만 1 로 둡니다. 올려둔 곳에서는 아무 힘이 없습니다.
DEV_FAKE_LOGIN=
